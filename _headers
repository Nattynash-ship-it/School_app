# Netlify headers — keep the app shell always fresh.
# The app is a single-file PWA; if the HTML or the service worker is cached by
# the CDN/browser, installed home-screen apps get stuck on an old build. Tell
# them to always revalidate (ETag still allows an efficient 304 when unchanged).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/__gate
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Launch images are content-addressed by device size and never change without a
# new filename, so they can be cached hard - unlike the app shell above.
/splash/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for everything. The app is one page that is never framed,
# never embedded and never meant to be indexed; these say so to the browser.
# The Content-Security-Policy is deliberately limited to what cannot break a
# single-file app that runs from inline scripts and styles: nothing may frame
# it, nothing may re-base its URLs, and no plugin objects may load.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
